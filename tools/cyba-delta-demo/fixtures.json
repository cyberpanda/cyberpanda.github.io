"templates_raw": [
{
"key": "notify_critical",
"title": "Tell the team about critical alerts",
"summary": "A critical alert arrives, and the channel that customer uses hears about it.",
"category": "routine",
"variables": [
{
"name": "room",
"label": "Room or channel",
"type": "string",
"default": "soc"
}
],
"workflow": {
"name": "Notify on critical alert",
"nodes": [
{
"id": "t1",
"type": "trigger",
"trigger": "alert",
"position": {
"x": 80,
"y": 160
}
},
{
"id": "c1",
"type": "condition",
"position": {
"x": 300,
"y": 160
},
"conditions": [
{
"field": "event.alert.severity",
"op": "equals",
"value": "critical"
}
]
},
{
"id": "a1",
"type": "action",
"channel": "chat",
"verb": "post",
"position": {
"x": 540,
"y": 90
},
"arguments": {
"title": "Critical: {{ event.alert.title }}",
"text": "Host {{ event.host.name }} - please take a look.",
"room": "{{room}}"
}
},
{
"id": "e1",
"type": "end",
"position": {
"x": 780,
"y": 160
}
}
],
"edges": [
{
"source": "t1",
"target": "c1"
},
{
"source": "c1",
"target": "a1",
"branch": "true"
},
{
"source": "c1",
"target": "e1",
"branch": "false"
},
{
"source": "a1",
"target": "e1"
}
]
}
},
{
"key": "ticket_for_case",
"title": "Open a ticket when a case starts",
"summary": "Every case gets a ticket, in whatever system that customer keeps.",
"category": "routine",
"variables": [
{
"name": "group",
"label": "Assign to group",
"type": "string",
"default": "SOC"
}
],
"workflow": {
"name": "Ticket for new case",
"nodes": [
{
"id": "t1",
"type": "trigger",
"trigger": "alert",
"position": {
"x": 80,
"y": 160
}
},
{
"id": "a1",
"type": "action",
"channel": "ticket",
"verb": "open",
"position": {
"x": 340,
"y": 160
},
"arguments": {
"title": "{{ event.alert.title }}",
"body": "Opened from {{ event.source.name }}.",
"group": "{{group}}"
}
},
{
"id": "a2",
"type": "action",
"channel": "mail",
"verb": "send",
"position": {
"x": 600,
"y": 160
},
"continue_on_error": true,
"arguments": {
"to": "{{ event.customer.email }}",
"subject": "We are on it: {{ event.alert.title }}",
"body": "Your ticket {{ steps.a1.ticket }} is with our team."
}
},
{
"id": "e1",
"type": "end",
"position": {
"x": 850,
"y": 160
}
}
],
"edges": [
{
"source": "t1",
"target": "a1"
},
{
"source": "a1",
"target": "a2"
},
{
"source": "a2",
"target": "e1"
}
]
}
},
{
"key": "daily_digest",
"title": "Send a calm daily summary",
"summary": "Once a day, one message with the numbers. No pager, no noise.",
"category": "routine",
"variables": [
{
"name": "hour",
"label": "Time of day",
"type": "string",
"default": "08:00"
},
{
"name": "recipient",
"label": "Send to",
"type": "string",
"default": "soc@example.com"
}
],
"workflow": {
"name": "Daily digest",
"nodes": [
{
"id": "t1",
"type": "trigger",
"trigger": "schedule",
"cron": "0 8 * * *",
"position": {
"x": 80,
"y": 160
}
},
{
"id": "a1",
"type": "action",
"channel": "mail",
"verb": "send",
"position": {
"x": 360,
"y": 160
},
"arguments": {
"to": "{{recipient}}",
"subject": "Daily summary",
"body": "Open alerts: {{ event.open_alerts }}. Have a good shift."
}
},
{
"id": "e1",
"type": "end",
"position": {
"x": 640,
"y": 160
}
}
],
"edges": [
{
"source": "t1",
"target": "a1"
},
{
"source": "a1",
"target": "e1"
}
]
}
},
{
"key": "triage_then_ask",
"title": "Ask before acting on a host",
"summary": "Check the alert, then ask the channel first. People stay in the loop.",
"category": "routine",
"variables": [],
"workflow": {
"name": "Ask before isolating",
"nodes": [
{
"id": "t1",
"type": "trigger",
"trigger": "alert",
"position": {
"x": 80,
"y": 160
}
},
{
"id": "c1",
"type": "condition",
"position": {
"x": 300,
"y": 160
},
"mode": "all",
"conditions": [
{
"field": "event.alert.severity",
"op": "in",
"value": [
"high",
"critical"
]
},
{
"field": "event.host.name",
"op": "exists",
"value": null
}
]
},
{
"id": "a1",
"type": "action",
"channel": "chat",
"verb": "post",
"position": {
"x": 560,
"y": 90
},
"arguments": {
"text": "{{ event.host.name }} looks affected. Isolate it? Reply in the thread.",
"title": "{{ event.alert.title }}"
}
},
{
"id": "e1",
"type": "end",
"position": {
"x": 820,
"y": 160
}
}
],
"edges": [
{
"source": "t1",
"target": "c1"
},
{
"source": "c1",
"target": "a1",
"branch": "true"
},
{
"source": "c1",
"target": "e1",
"branch": "false"
},
{
"source": "a1",
"target": "e1"
}
]
}
}
],
